generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  ENGINEER
}

enum FrequencyType {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  CUSTOM_DAYS
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ISSUE_FOUND
}

enum ChecklistResponseStatus {
  PASS
  FAIL
  NA
}

enum ReportStatus {
  ALL_OK
  ISSUES_FOUND
}

model User {
  id           String             @id @default(cuid())
  name         String
  email        String             @unique
  role         UserRole
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  routeLinks   RouteAssignment[]
  assignedTasks Task[]            @relation("AssignedEngineerTasks")
  completedTasks Task[]           @relation("CompletedByUserTasks")
}

model Client {
  id                  String    @id @default(cuid())
  name                String
  primaryContactName  String?
  primaryContactEmail String?
  phone               String?
  createdAt           DateTime  @default(now())
  sites               Site[]
}

model Site {
  id                        String        @id @default(cuid())
  clientId                  String
  name                      String
  addressLine1              String
  addressLine2              String?
  city                      String?
  postcode                  String?
  notes                     String?
  clientEmail               String?
  internalNotificationEmail String?
  createdAt                 DateTime      @default(now())
  client                    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  routeId                   String?
  route                     Route?        @relation(fields: [routeId], references: [id], onDelete: SetNull)
  services                  SiteService[]
  tasks                     Task[]

  @@index([clientId])
  @@index([routeId])
}

model ServiceType {
  id               String       @id @default(cuid())
  name             String       @unique
  defaultFrequency FrequencyType
  description      String?
  createdAt        DateTime     @default(now())
  siteServices     SiteService[]
  checklists       Checklist[]
  tasks            Task[]
}

model SiteService {
  id              String        @id @default(cuid())
  siteId          String
  serviceTypeId   String
  frequencyType   FrequencyType
  frequencyValue  Int?
  active          Boolean       @default(true)
  nextDueDate     DateTime
  createdAt       DateTime      @default(now())
  site            Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  serviceType     ServiceType   @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  tasks           Task[]

  @@unique([siteId, serviceTypeId])
  @@index([nextDueDate, active])
}

model Checklist {
  id            String          @id @default(cuid())
  serviceTypeId String
  name          String
  version       Int             @default(1)
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  serviceType   ServiceType     @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  items         ChecklistItem[]
  taskChecklists TaskChecklist[]

  @@unique([serviceTypeId, version])
}

model ChecklistItem {
  id           String             @id @default(cuid())
  checklistId  String
  label        String
  inputType    String             @default("pass_fail_na")
  required     Boolean            @default(true)
  orderIndex   Int
  checklist    Checklist          @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  responses    TaskResponse[]

  @@index([checklistId, orderIndex])
}

model Route {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  sites       Site[]
  assignments RouteAssignment[]
}

model RouteAssignment {
  id         String   @id @default(cuid())
  routeId    String
  engineerId String
  createdAt  DateTime @default(now())
  route      Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  engineer   User     @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@unique([routeId, engineerId])
}

model Task {
  id                 String         @id @default(cuid())
  siteId             String
  siteServiceId      String
  serviceTypeId      String
  assignedEngineerId String?
  completedById      String?
  dueDate            DateTime
  status             TaskStatus     @default(PENDING)
  completedAt        DateTime?
  createdAt          DateTime       @default(now())
  site               Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteService        SiteService    @relation(fields: [siteServiceId], references: [id], onDelete: Cascade)
  serviceType        ServiceType    @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  assignedEngineer   User?          @relation("AssignedEngineerTasks", fields: [assignedEngineerId], references: [id], onDelete: SetNull)
  completedBy        User?          @relation("CompletedByUserTasks", fields: [completedById], references: [id], onDelete: SetNull)
  checklistSnapshot  TaskChecklist?
  responses          TaskResponse[]
  attachments        TaskAttachment[]
  report             Report?

  @@index([assignedEngineerId, dueDate])
  @@index([status, dueDate])
}

model TaskChecklist {
  id          String    @id @default(cuid())
  taskId       String    @unique
  checklistId  String
  checklist    Checklist @relation(fields: [checklistId], references: [id], onDelete: Restrict)
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskResponse {
  id               String                  @id @default(cuid())
  taskId            String
  checklistItemId   String
  responseValue     String?
  status            ChecklistResponseStatus
  notes             String?
  createdAt         DateTime                @default(now())
  task              Task                    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  checklistItem     ChecklistItem           @relation(fields: [checklistItemId], references: [id], onDelete: Restrict)

  @@index([taskId])
}

model TaskAttachment {
  id         String   @id @default(cuid())
  taskId      String
  fileUrl     String
  createdAt   DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Report {
  id             String       @id @default(cuid())
  taskId          String       @unique
  reportStatus    ReportStatus
  sentToClient    Boolean      @default(false)
  sentToInternal  Boolean      @default(false)
  createdAt       DateTime     @default(now())
  task            Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
}
